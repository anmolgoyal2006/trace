# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# SQLite — all .db files (never commit the database)
*.db
db/

# Model weights
*.pt
*.pth
*.onnx
weights/
pretrained_models/

# External model repos (cloned per README setup, not part of Trace)
keypoint_promptable_reidentification/
SOLIDER-REID/

# Local gallery backups (e.g. OSNet gallery kept when switching to SOLIDER)
dataset/embeddings_*_osnet.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Environment
.env
*.env.*
!.env.example

# Large dataset files — store in Google Drive, not git
# See docs/git_workflow.md for the shared Drive link
dataset/raw_videos/*.mp4
dataset/raw_videos/*.avi
dataset/raw_videos/*.mov
dataset/raw_videos/*.mkv

# Processed / intermediate pipeline outputs (can be regenerated)
dataset/processed/
dataset/embeddings/
dataset/detections/

# Logs
logs/
*.log

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
