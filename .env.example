# =============================================================================
# Trace — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your setup.
# Paths can be absolute or relative to the project root.
# Optional values can be left empty — those pipeline steps will be skipped.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true

# -----------------------------------------------------------------------------
# Face embedding — SCRFD + ArcFace (optional)
# Download:
#   det_10g.onnx   → https://huggingface.co/yakhyo/scrfd/resolve/main/det_10g.onnx
#   w600k_r50.onnx → https://huggingface.co/yakhyo/arcface/resolve/main/w600k_r50.onnx
# Save both into: weights/
# pip install onnxruntime  (or onnxruntime-gpu for GPU)
# -----------------------------------------------------------------------------
FACE_DET_MODEL=weights/det_10g.onnx
FACE_REC_MODEL=weights/w600k_r50.onnx
FACE_DET_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# KPR part-based matching (optional — GPU strongly recommended)
# Setup:
#   git clone https://github.com/VlSomers/keypoint_promptable_reidentification
#   cd keypoint_promptable_reidentification && pip install -r requirements.txt && python setup.py develop
# Weights: https://drive.google.com/file/d/1Np5wu3nQa_Fl_z7Zw2kchJNC8JZVwsh5/view
#   Save as: pretrained_models/kpr_occ_pt_IN_82.34_92.33_42323828.pth.tar
# -----------------------------------------------------------------------------
KPR_WEIGHTS_PATH=pretrained_models/kpr_occ_pt_IN_82.34_92.33_42323828.pth.tar
KPR_CONFIG_PATH=keypoint_promptable_reidentification/configs/kpr/market1501/kpr_swin_small.yaml
KPR_VIS_THRESHOLD=0.30

# -----------------------------------------------------------------------------
# SOLIDER body embedding (optional — cloth-change robust)
# Setup:
#   git clone https://github.com/tinyvision/SOLIDER-REID
#   pip install timm
# Weights: https://github.com/tinyvision/SOLIDER-REID/releases
#   Save as: pretrained_models/SOLIDER_REID_swin_small.pth
# -----------------------------------------------------------------------------
SOLIDER_WEIGHTS=pretrained_models/SOLIDER_REID_swin_small.pth
SOLIDER_CONFIG_PATH=SOLIDER-REID/configs/market/swin_small.yml
SOLIDER_EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Re-ID matching
# -----------------------------------------------------------------------------
REID_MODEL=osnet_x1_0
EMBEDDING_DIM=512
NO_MATCH_THRESHOLD=0.74
TOP_K=5

# -----------------------------------------------------------------------------
# Fusion weights (must be > 0, re-normalised automatically at runtime)
# KPR dominates — best at partial bodies (common in CCTV)
# Face is gated on >= 30% detection coverage per track
# -----------------------------------------------------------------------------
FUSION_BODY_WEIGHT=0.40
FUSION_FACE_WEIGHT=0.30
FUSION_KPR_WEIGHT=0.60

# -----------------------------------------------------------------------------
# YOLOv8 detection
# -----------------------------------------------------------------------------
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.6
